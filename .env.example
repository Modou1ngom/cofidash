APP_NAME="COFIBANK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cofibank
DB_USERNAME=root
DB_PASSWORD=

# Service Python (Oracle)
PYTHON_SERVICE_URL=http://localhost:8001

# Durée de cache des réponses Oracle côté Laravel (secondes). 0 = désactivé.
ORACLE_DATA_CACHE_TTL=300

# CORS — Flutter Web (ports localhost dynamiques gérés via allowed_origins_patterns)
# CORS_ALLOWED_ORIGINS=http://localhost:43261,https://app.cofina.sn

# App mobile — contrôle de version (GET /api/v1/app/version)
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MIN_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.cofina.cofina_client_vue360
MOBILE_STORE_URL_IOS=https://apps.apple.com/app/id0000000000
MOBILE_UPDATE_MESSAGE="Une nouvelle version de l'application est disponible."

