# Copier vers .env et renseigner les secrets (ne pas committer .env)

# ── Oracle Flexcube (CFSFCUBS145) — KYC, crédits, écritures, C360 ──
# Alias acceptés : ORACLE_* (legacy) ou ORACLE_FLEXCUBE_*
ORACLE_FLEXCUBE_HOST=
ORACLE_FLEXCUBE_PORT=1522
ORACLE_FLEXCUBE_SERVICE_NAME=
ORACLE_FLEXCUBE_USERNAME=
# Mettre entre quotes simples si # ou $ dans le mot de passe
ORACLE_FLEXCUBE_PASSWORD=''

# Alias legacy (utilisés si ORACLE_FLEXCUBE_* absent)
# ORACLE_HOST=
# ORACLE_PORT=1522
# ORACLE_SERVICE_NAME=
# ORACLE_USERNAME=
# ORACLE_PASSWORD=''

# ── Oracle Cofina / REPORT_GROUPE — tables DASH (CUSTOMERS, DASH_PRET, …) ──
ORACLE_COFINA_HOST=
ORACLE_COFINA_PORT=
ORACLE_COFINA_SERVICE_NAME=
ORACLE_COFINA_USERNAME=
ORACLE_COFINA_PASSWORD=''

# Collecte (domiciliation) — si ORA-00942 : un seul schéma pour les 3 tables
# ORACLE_DASH_SCHEMA=OWNER_QUI_CONTIENT_LES_DASH
# ou chaque table : ORACLE_DASH_ETAT_CPT_TABLE=OWNER.DASH_ETAT_CPT
# DASH_RELATION (clients / synchro agences) :
# ORACLE_DASH_RELATION_TABLE=OWNER.DASH_RELATION
# Réponse 500 au lieu de zéros : ORACLE_DOMICILIATION_ORA942_EMPTY=0

# C360 — base SQLite locale (cache mobile)
# C360_LOCAL_DB_PATH=python-service/data/c360_cache.sqlite
