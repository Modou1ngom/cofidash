@startuml cas_utilisation_acteurs
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #1565C0
}
skinparam actor {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam sequenceMessageAlign center
skinparam ActivityDiamondBackgroundColor #FFF8E1
title Figure 3.2 — Acteurs de COFIdash\n(un diagramme de cas d'utilisation par profil : figures 3.2a à 3.2i)

left to right direction

actor "Utilisateur\nauthentifié" as U

actor "Directeur Général\n(MD)" as MD
actor "Directeur Général\nAdjoint (DGA)" as DGA
actor "Responsable Zone" as RZ
actor "Chef d'Agence" as CA
actor "CAF" as CAF
actor "Conseiller Client\n(CC)" as CC
actor "Finances" as FIN
actor "Exploitations" as EXP
actor "Administrateur" as ADM

U <|-- MD
U <|-- DGA
U <|-- RZ
U <|-- CA
U <|-- CAF
U <|-- CC
U <|-- FIN
U <|-- EXP
U <|-- ADM

note bottom of U
  Authentification : Laravel Sanctum
  (jeton Bearer, pas JWT)

  Périmètre des données (Vue360ScopeService) :
  • MD / DGA / Admin → réseau national
  • Responsable Zone → agences du territoire
  • Chef d'agence / CAF / CC → son agence
end note

note right of MD
  Figure 3.2a
end note
note right of DGA
  Figure 3.2b
end note
note right of RZ
  Figure 3.2c
end note
note right of CA
  Figure 3.2d
end note
note right of CAF
  Figure 3.2e
end note

@enduml
