@startuml activite_objectifs_couloirs
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #1565C0
}
skinparam actor {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam sequenceMessageAlign center
skinparam ActivityDiamondBackgroundColor #FFF8E1
title Figure 3.6 — Activité : chaîne de validation (un couloir par utilisateur)

|Chef d'Agence|
start
:Fixe les objectifs CAF;
:Statut = pending_validation;

|Responsable Zone|
:Fixe les objectifs d'agence;
:Statut = pending_validation;
if (Objectif du Chef ?) then (oui)
  if (Décision ?) then (valider)
    :status = validated;
  else (rejeter)
    :status = rejected;
    stop
  endif
endif

|DGA|
:Répartit l'objectif MD\nsur les territoires;
:Statut = pending_validation;
if (Objectif du Resp. Zone ?) then (oui)
  if (Décision ?) then (valider)
    :status = validated;
  else (rejeter)
    :status = rejected;
    stop
  endif
endif

|MD|
if (Objectif du DGA ?) then (oui)
  if (Décision ?) then (valider)
    :status = validated;
  else (rejeter)
    :status = rejected;
    stop
  endif
endif

|CAF|
:Consulte mes objectifs\nvalidés / en attente;
:Compare réalisé vs objectif;

stop

note bottom
  Statuts réels : draft, pending_validation, validated, rejected
  MD / Admin : création en validated (pas de passage par pending_validation)
end note

@enduml
