@startuml sequence_kpi_md
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #1565C0
}
skinparam actor {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam sequenceMessageAlign center
skinparam ActivityDiamondBackgroundColor #FFF8E1
title Figure 3.4a — Séquence : le MD consulte un KPI (production volume)

actor "Directeur Général\n(MD)" as MD
participant "Vue Dashboard" as V
participant "Laravel API\nDataController" as L
participant "OracleService" as O
participant "FastAPI\n/api/oracle" as P
database "Oracle REPORT_GROUPE\nDASH_PRODUCTION_VOLUME" as DWH

MD -> V : Ouvre Production en volume\n(période / réseau national)
V -> L : GET /api/oracle/data/production-volume\nAuthorization: Bearer (Sanctum)
activate L
L -> L : Vérifie token + profil MD
L -> O : getPythonGetCached(...)
activate O

alt Cache Laravel (TTL 300 s)
  O --> L : Données en cache
else Cache miss
  O -> P : GET /api/oracle/data/production-volume
  activate P
  P -> DWH : SELECT ... WHERE MIGRATION_DATETIME =\nMAX(lot) filtré sur MIGRATION_DATE_MINUS1
  activate DWH
  DWH --> P : Lignes agrégées
  deactivate DWH
  P --> O : JSON
  deactivate P
  O -> O : Cache::put (300 s)
end

O --> L : KPI réseau
deactivate O
L --> V : JSON
deactivate L
V --> MD : Cartes + graphiques (FCFA, variation %)

note over MD
  Périmètre : tout le réseau
  (Vue360ScopeService : rôle dga, pas de filtre)
end note

@enduml
